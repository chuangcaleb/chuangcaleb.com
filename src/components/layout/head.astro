---
import {Font} from 'astro:assets';
import {ClientRouter} from 'astro:transitions';
import faviconAppleTouchUrl from '~/assets/favicon/apple-touch-icon.png';
import favicon16Url from '~/assets/favicon/favicon-16x16.png';
import favicon32Url from '~/assets/favicon/favicon-32x32.png';
import faviconUrl from '~/assets/favicon/favicon.ico';
import SITE from '~/data/site.ts';
import {THEME_STORAGE_KEY} from '~/utils/theme.ts';
import profileImg from '~/assets/img/profile.jpg';

interface Props {
	title?: string | null;
	description?: string;
}

const {title: propsTitle, description: propsDescription} = Astro.props;

const {pathname} = Astro.url;
const isHome = pathname === '/';
const isNotesRoute = pathname.startsWith('/notes');

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const title = propsTitle
	? propsTitle + (isHome ? '' : ` | ${SITE.title}`)
	: SITE.title;
const description
	= propsDescription
		?? (isNotesRoute ? SITE.siteDescriptionFallback : SITE.description);
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width, initial-scale=1.0' />
<meta name='generator' content={Astro.generator} />

{/* SEO */}
<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />
<meta name='author' content={SITE.author.name} />
<link rel='canonical' href={canonicalUrl.href} />
<link rel='sitemap' href='/sitemap-index.xml' />

{/* Open Graph */}
<meta property='og:type' content='website' />
<meta property='og:title' content={title} />
<meta property='og:site_name' content={SITE.title} />
<meta property='og:url' content={canonicalUrl.href} />
<meta property='og:image' content={profileImg.src} />
{description && <meta property='og:description' content={description} />}

{/* Twitter */}
<meta property='twitter:card' content='summary' />
<meta property='twitter:title' content={title} />
<meta property='twitter:image' content={profileImg.src} />
{description && <meta property='twitter:description' content={description} />}

{/* Favicon */}
<link rel='shortcut icon' href={faviconUrl} />
<link rel='apple-touch-icon' sizes='180x180' href={faviconAppleTouchUrl.src} />
<link rel='icon' type='image/png' sizes='32x32' href={favicon32Url.src} />
<link rel='icon' type='image/png' sizes='16x16' href={favicon16Url.src} />

{/* Manifest */}
<link rel='manifest' href='/site.webmanifest' />

{/* Theme */}
<meta
	name='theme-color'
	content={SITE.color.light}
	media=' (prefers-color-scheme: light)'
/>
<meta
	name='theme-color'
	content={SITE.color.dark}
	media=' (prefers-color-scheme: dark)'
/>
<meta name='msapplication-TileColor' content={SITE.color.light} />

{/* Theme color (updated by footer theme toggle script; #f5f4ed is the light-mode/no-JS fallback) */}
<meta id='theme-color-meta' name='theme-color' content='#f5f4ed' />

<script is:inline define:vars={{storageKey: THEME_STORAGE_KEY}}>
  /* global storageKey */
  var pref = localStorage.getItem(storageKey);
  var systemDark =
    pref === "system" && matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.dataset.theme =
    pref === "dark" || systemDark ? "dark" : "light";
</script>

<Font cssVariable='--font-mono' />

<ClientRouter />
