---
import NoteTag from './note-tag.astro';
import type {SuperNote} from 'lib/utils/types.ts';
import {noteToTags} from '~/utils/note-metadata.ts';
import {formatYearMonth} from '~/utils/time.ts';

interface Props {
	note: SuperNote;
	showDate?: 'published' | 'modified';
}

const {note, showDate} = Astro.props;
const dateValue = showDate ? note.data[showDate] : undefined;
const dateLabel = formatYearMonth(dateValue);
const tags = noteToTags(note.data, ['status']);
---

<div class:list={['root', dateLabel && 'has-date']}>
	<div class='item'>
		{dateLabel && (
			<time class='date' datetime={dateValue?.toISOString()}>
				{dateLabel}
			</time>
		)}
		<div class='main'>
			<a class='title' href={note.route}>{note.title}</a>
			{tags.length > 0 && (
				<span class='tags'>
					{tags.map(tag => <NoteTag {...tag} />)}
				</span>
			)}
		</div>
	</div>
</div>

<style>
	/* Date column replaces list marker */
	:global(li:has(> .root.has-date)) {
		list-style: none;
		padding-inline-start: 0;
	}

	:global(ul:has(> li > .root.has-date)) {
		padding-inline-start: 0;
	}

	.root {
		container-type: inline-size;
		white-space: nowrap;
	}

	.date {
		grid-area: date;
		color: var(--text-tertiary);
		font-size: var(--text-caption);
		font-family: var(--font-mono);
	}

	.main {
		grid-area: main;
		min-width: 0;
	}

	.title {
		white-space: normal;
	}

	/* Inline after title text; follows last wrapped line */
	.tags {
		grid-area: tags;
		display: inline-flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		margin-inline-start: var(--space-xs);
		min-width: 0;
	}

	.item {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-areas: 'main';
		align-items: first baseline;
		column-gap: var(--space-s);
	}

	/* Wide: `date main`, tags flow inline inside main */
	.has-date .item {
		grid-template-columns: auto 1fr;
		grid-template-areas: 'date main';
	}

	@container (inline-size < 30rem) {
		/* Narrow: unwrap main so title + tags become grid items; `date tags` / `title` */
		.has-date .item {
			grid-template-areas:
				'date tags'
				'title title';
			/* Group stacked rows: pad items apart, keep own rows tight */
			padding-block: var(--space-2xs);
		}

		.has-date .main {
			display: contents;
		}

		.has-date .title {
			grid-area: title;
		}

		.has-date .tags {
			margin-inline-start: 0;
		}
	}
</style>
